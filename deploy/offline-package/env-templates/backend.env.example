# ==============================================================================
# SmartLib Backend Engine — Offline Deployment Environment Template
# Copy this file to backend/.env and supply institutional secrets before starting
# NEVER commit or package real credentials, passwords, or JWT keys.
# ==============================================================================

NODE_ENV=production
PORT=5000

# Neon Serverless PostgreSQL or Institutional PostgreSQL 15+ Connection URI
# Note: SmartLib requires connectivity to the configured PostgreSQL endpoint
# for catalog and circulation transactions.
DATABASE_URL="postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/smartlib?sslmode=require"

# Authentication Secrets (Generate with: openssl rand -hex 32)
JWT_ACCESS_SECRET="<REPLACE_WITH_64_CHAR_HEX_SECRET>"
JWT_REFRESH_SECRET="<REPLACE_WITH_64_CHAR_HEX_SECRET>"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Frontend & RFID Middleware Origins
CORS_ORIGIN="http://localhost:5173"
RFID_MIDDLEWARE_URL="http://localhost:8001"
MOCK_RFID_MODE="true"

