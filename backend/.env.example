# ==============================================================================
# SmartLib — Backend Environment Configuration Example
# ==============================================================================
# Copy this file to .env and fill in your actual institutional credentials.
# NEVER commit your actual .env file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NEON SERVERLESS POSTGRESQL CONFIGURATION
# ------------------------------------------------------------------------------
# Neon connection pooling (PgBouncer port 6543) for runtime application queries
DATABASE_URL="postgresql://[username]:[password]@[neon-project-id]-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=20"

# Neon direct connection (Compute port 5432) required for Prisma schema migrations
DIRECT_URL="postgresql://[username]:[password]@[neon-project-id].us-east-2.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. SERVER & RUNTIME SETTINGS
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (JWT)
# ------------------------------------------------------------------------------
# Generate cryptographically secure random keys (e.g. openssl rand -base64 32)
JWT_ACCESS_SECRET="replace-with-a-secure-random-32-byte-hex-string-for-access-token"
JWT_ACCESS_EXPIRES_IN="15m"

JWT_REFRESH_SECRET="replace-with-a-secure-random-32-byte-hex-string-for-refresh-token"
JWT_REFRESH_EXPIRES_IN="7d"

BCRYPT_SALT_ROUNDS=12

# ------------------------------------------------------------------------------
# 4. RFID HARDWARE MIDDLEWARE SERVICE
# ------------------------------------------------------------------------------
# Endpoint for Python FastAPI edge RFID reader gateway
RFID_MIDDLEWARE_URL="http://localhost:8000"
RFID_MIDDLEWARE_API_KEY="replace-with-edge-hardware-auth-secret-key"

# Set to true to enable mock hardware emulators (virtual staff station, gate, and wand)
MOCK_RFID_MODE=true

# ------------------------------------------------------------------------------
# 5. COMMUNICATION & NOTIFICATION ADAPTERS
# ------------------------------------------------------------------------------
# Email SMTP Configuration
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-smtp-username"
SMTP_PASS="your-smtp-password"
SMTP_FROM="SmartLib Automated Desk <library-alerts@institution.edu>"

# SMS Gateway Configuration (Mock/HTTP endpoint)
SMS_GATEWAY_URL="https://api.sms-provider.com/v1/send"
SMS_API_KEY="your-sms-api-key"
SMS_SENDER_ID="SMARTLIB"

# Network Receipt Printer Adapter (ESC/POS)
RECEIPT_PRINTER_IP="192.168.1.150"
RECEIPT_PRINTER_PORT=9100

# ------------------------------------------------------------------------------
# 6. DATA MIGRATION ENGINE (20,000 RECORDS)
# ------------------------------------------------------------------------------
MIGRATION_TEMP_DIR="./uploads/migration"
MIGRATION_MAX_FILE_SIZE_MB=50
MIGRATION_BATCH_CHUNK_SIZE=500

# ------------------------------------------------------------------------------
# 7. LOGGING & OBSERVABILITY
# ------------------------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json

