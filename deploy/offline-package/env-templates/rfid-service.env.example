# ==============================================================================
# SmartLib RFID Middleware (FastAPI + SQLite Offline Buffer) — Environment Template
# Copy to rfid-service/.env before starting the middleware service
# ==============================================================================

SERVICE_NAME="smartlib-rfid-middleware"
ENVIRONMENT="production"
HOST="0.0.0.0"
PORT=8001

# Hardware Emulation Mode (set false when physical UHF/HF readers are attached)
MOCK_RFID_MODE=true

# Backend API Integration
BACKEND_API_URL="http://localhost:5000/api/v1"
BACKEND_TIMEOUT_SECONDS=10

# Local SQLite Offline Event Buffer (buffers gate/reader events during backend outages)
SQLITE_BUFFER_PATH="./data/offline_events.db"
SYNC_INTERVAL_SECONDS=15
MAX_SYNC_RETRIES=5

