# ==============================================================================
# SmartLib — RFID Middleware Service
# Environment Configuration Example
# ==============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVICE SETTINGS
# ------------------------------------------------------------------------------
SERVICE_NAME=smartlib-rfid-middleware
SERVICE_PORT=8000
LOG_LEVEL=INFO
MOCK_HARDWARE=true          # true = mock emulators, false = real hardware drivers

# ------------------------------------------------------------------------------
# 2. BACKEND API CONNECTION
# ------------------------------------------------------------------------------
BACKEND_API_URL=http://localhost:5000/api/v1
BACKEND_API_KEY=replace-with-rfid-service-api-key
BACKEND_LOGIN_EMAIL=admin@smartlib.ac.in
BACKEND_LOGIN_PASSWORD=Admin@SmartLib2026!
BACKEND_REQUEST_TIMEOUT=10          # seconds
BACKEND_MAX_RETRIES=3
BACKEND_RETRY_DELAY=2.0             # seconds between retries

# ------------------------------------------------------------------------------
# 3. OFFLINE SQLITE EVENT BUFFER
# ------------------------------------------------------------------------------
SQLITE_BUFFER_PATH=./data/offline_events.db
BUFFER_MAX_EVENTS=100000            # Maximum events to retain locally
SYNC_BATCH_SIZE=50                  # Events to sync per batch
SYNC_INTERVAL_SECONDS=30            # Automatic sync retry interval

# ------------------------------------------------------------------------------
# 4. DEVICE CONFIGURATION (MOCK)
# ------------------------------------------------------------------------------
STAFF_STATION_DEVICE_ID=DEV-SS-001
HANDHELD_DEVICE_ID=DEV-HH-001
SECURITY_GATE_DEVICE_ID=DEV-SG-001

# Gate polling rate (Hz) — real hardware: 20 Hz; mock: simulated
GATE_POLL_RATE_HZ=20
STAFF_STATION_MAX_TAGS=5

# ------------------------------------------------------------------------------
# 5. CORS SETTINGS
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5000

